# ============================================
# 应用基础配置（复制为 .env 后按需修改）
# ============================================

# 浏览器标签页 / 系统名称
VITE_APP_TITLE=鸿蒙云包网管理系统

# 本地存储命名空间（不同项目必须不同，避免缓存冲突）
VITE_APP_NAMESPACE=admin-template

# Pinia 持久化加密密钥（请替换为随机字符串）
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# ============================================
# API 配置（新项目主要改这里）
# ============================================

# 前端请求前缀（开发环境一般保持 /api，由 Vite 代理转发）
# 生产环境改为完整 API 地址，例如：https://api.example.com/api
VITE_GLOB_API_URL=/api

# 开发环境代理目标（backend-mock 默认 5320）
# 接真实后端示例：https://api.example.com/api
VITE_API_PROXY_TARGET=http://localhost:5320/api

# 后端成功响应 code 字段的期望值（cloudPlatform 为 200）
VITE_API_SUCCESS_CODE=200

# 文件上传地址（可选，无则使用 VITE_GLOB_API_URL）
# VITE_FILE_UPLOAD_URL=https://api.example.com/api

# 静态资源 CDN / 文件服务根地址（可选，用于拼接头像等路径）
# VITE_STATIC_URL=https://cdn.example.com

# ============================================
# cloudPlatform 专用配置
# ============================================

# AES 加密 Key / IV（生产环境生效，开发环境不加密）
VITE_CRYPTO_KEY=FOM96AN4V7YlYVWgvDK47AJE9NnVL5uX
VITE_CRYPTO_IV=0000000000000000

# VOIP 服务地址
# VITE_VOIP_BASE_API=https://voip-service.uat.oureax.io

# WebSocket 地址（后续 P5 实时模块使用）
# VITE_WBSOCKT_URL=wss://customer.d-dev.xyz/ws/serviceJoin
# VITE_MJ_WBSOCKT_URL=ws://192.168.43.12:30006/ws/managerJoin
# VITE_BS_WBSOCKT_URL=wss://www.dayihangqingwang.com/bs/ws/dealerJoin
# VITE_BS_MJ_WBSOCKT_URL=wss://www.dayihangqingwang.com/bs/ws/managerJoin
# VITE_GATEWAY_CONFIG=wss://gateway.d-dev.xyz

# 上传 / 静态资源
# VITE_UPLOAD_URL=https://your-api.com/api/uploadfile
# VITE_UPLOAD_IMG=https://your-api.com/api/uploadimg/
# VITE_SERVICE_IMG=https://down.dk888.link/
