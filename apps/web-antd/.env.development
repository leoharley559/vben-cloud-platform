# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# cloudPlatform 研发环境 API（与旧项目 dev.env.js 对齐）
VITE_API_PROXY_TARGET=https://ccccc-admin.dk888.link

# cloudPlatform 成功码为 200
VITE_API_SUCCESS_CODE=200

# 关闭 Mock，连接真实后端
VITE_NITRO_MOCK=false

# 是否打开 devtools
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 应用名称
VITE_APP_TITLE=鸿蒙云包网管理系统

# AES 加密（生产构建时生效）
VITE_CRYPTO_KEY=FOM96AN4V7YlYVWgvDK47AJE9NnVL5uX
VITE_CRYPTO_IV=0000000000000000

# VOIP
VITE_VOIP_BASE_API=https://voip-service.uat.oureax.io
