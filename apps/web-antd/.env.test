# 测试环境前端配置（pnpm release:test）
# 与正式服一致：相对路径 /api + 同域 Nginx（站点 https://cloud.dk888.link）

VITE_BASE=/

# 接口根地址（相对路径，由站点 Nginx 反代到真实后端）
VITE_GLOB_API_URL=/api

# cloudPlatform 成功码
VITE_API_SUCCESS_CODE=200

# 与正式服行为一致：不写兜底 AuthToken。测试包若需无 cookie 登录，改为 true
VITE_ENABLE_AES=false
VITE_USE_FALLBACK_AUTH_TOKEN=false

# AES Key / IV（仅 VITE_ENABLE_AES=true 时生效）
VITE_CRYPTO_KEY=FOM96AN4V7YlYVWgvDK47AJE9NnVL5uX
VITE_CRYPTO_IV=0000000000000000

# 图片资源库（老站 SERVICE_IMG，仍走独立 CDN 域名）
VITE_SERVICE_IMG=https://cloud.dk888.link/down-static/

# 上传（相对路径，走同域 /api 反代）
VITE_UPLOAD_MD5_IMG=/api/resource/uploadimagemd5
VITE_UPLOAD_URL=/api/uploadfile
VITE_UPLOAD_IMG=/api/uploadimg/

# VOIP
VITE_VOIP_BASE_API=https://voip-service.uat.oureax.io

# WebSocket（老站 WBSOCKT_* / GATEWAY_CONFIG）
VITE_WBSOCKT_URL=wss://customer.d-dev.xyz/ws/serviceJoin
VITE_MJ_WBSOCKT_URL=ws://192.168.43.12:30006/ws/managerJoin
VITE_BS_WBSOCKT_URL=wss://www.dayihangqingwang.com/bs/ws/dealerJoin
VITE_BS_MJ_WBSOCKT_URL=wss://www.dayihangqingwang.com/bs/ws/managerJoin
VITE_GATEWAY_CONFIG=wss://gateway.d-dev.xyz

# 应用名称
VITE_APP_TITLE=乐赢管理后台

# 是否开启压缩：none / brotli / gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 模式（静态部署用 hash，不依赖 nginx 回退）
VITE_ROUTER_HISTORY=hash

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成 dist.zip
VITE_ARCHIVER=true
